{
  "version": 1,
  "description": "隐私守卫策略：只允许标准 Mock ID 段出现在身份 ID 上下文中，杜绝真实 QQ 号/群号入库。",
  "idLength": {
    "minDigits": 7,
    "maxDigits": 11
  },
  "allowedRanges": [
    { "from": 1000000000, "to": 1000000099, "note": "标准 Mock：用户 / Bot QQ（含隐私脱敏段 1000000010-1000000019）" },
    { "from": 2000000000, "to": 2000000099, "note": "标准 Mock：普通用户" },
    { "from": 3000000000, "to": 3000000099, "note": "标准 Mock：群聊" },
    { "from": 3200000000, "to": 3200000099, "note": "标准 Mock：群聊（并发/队列场景）" },
    { "from": 4000000000, "to": 4000000099, "note": "标准 Mock：陌生人 / 临时会话" },
    { "from": 8000000000, "to": 8000000099, "note": "标准 Mock：测试群" }
  ],
  "allowedLiterals": ["10000", "20050606"],
  "identityKeys": [
    "user_id",
    "userId",
    "userID",
    "group_id",
    "groupId",
    "groupID",
    "sender_id",
    "senderId",
    "target_id",
    "targetId",
    "self_id",
    "selfId",
    "from_user",
    "fromUser",
    "target_uin",
    "targetUin",
    "friend_id",
    "friendId",
    "peer_id",
    "peerId",
    "owner_id",
    "ownerId",
    "admin_id",
    "adminId",
    "bot_qq",
    "botQQ",
    "uin",
    "qq"
  ],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".git/**",
    "pnpm-lock.yaml",
    "package-lock.json",
    "*.zst",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.sqlite",
    "*.db",
    "*.bundle"
  ]
}
